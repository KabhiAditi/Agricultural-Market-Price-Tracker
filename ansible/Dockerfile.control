FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install Ansible, OpenSSH client, sshpass, and python tooling
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ansible \
        openssh-client \
        sshpass \
        curl \
        ca-certificates \
        python3 \
        python3-pip && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /ansible

CMD ["ansible-playbook", "--syntax-check", "-i", "inventory.ini", "site.yml"]
